class Main {
    void main() {
        println("Testing control flow:");

        int x = 10;

        if (x > 5) {
            println("x is greater than 5");
        } else {
            println("x is not greater than 5");
        }

        int i = 0;
        while (i < 3) {
            println("Loop iteration");
            i = i + 1;
        }

        println("Control flow test complete!");
    }
}
